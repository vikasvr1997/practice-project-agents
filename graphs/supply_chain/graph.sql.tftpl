-- Generated by graphkit from graph_spec.json. Terraform fills in the project and dataset.
CREATE OR REPLACE PROPERTY GRAPH `${project}.${dataset}.SupplyChain`
  NODE TABLES (
    `${project}.${dataset}.parts` AS Part
      KEY (part_id)
      LABEL Part PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.plants` AS Plant
      KEY (plant_id)
      LABEL Plant PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.recalls` AS Recall
      KEY (recall_id)
      LABEL Recall PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.suppliers` AS Supplier
      KEY (supplier_id)
      LABEL Supplier PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.vehicle_models` AS VehicleModel
      KEY (model_id)
      LABEL VehicleModel PROPERTIES ALL COLUMNS
  )
  EDGE TABLES (
    `${project}.${dataset}.part_usage` AS USED_IN
      KEY (part_id, model_id)
      SOURCE KEY (part_id) REFERENCES Part (part_id)
      DESTINATION KEY (model_id) REFERENCES VehicleModel (model_id)
      LABEL USED_IN PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.parts` AS MADE_BY
      KEY (part_id)
      SOURCE KEY (part_id) REFERENCES Part (part_id)
      DESTINATION KEY (supplier_id) REFERENCES Supplier (supplier_id)
      LABEL MADE_BY PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.parts` AS SUPPLIES
      KEY (part_id)
      SOURCE KEY (supplier_id) REFERENCES Supplier (supplier_id)
      DESTINATION KEY (part_id) REFERENCES Part (part_id)
      LABEL SUPPLIES PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.recall_models` AS AFFECTS
      KEY (recall_id, model_id)
      SOURCE KEY (recall_id) REFERENCES Recall (recall_id)
      DESTINATION KEY (model_id) REFERENCES VehicleModel (model_id)
      LABEL AFFECTS PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.recall_parts` AS RECALLS_PART
      KEY (recall_id, part_id)
      SOURCE KEY (recall_id) REFERENCES Recall (recall_id)
      DESTINATION KEY (part_id) REFERENCES Part (part_id)
      LABEL RECALLS_PART PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.shipments` AS SHIPS_TO
      KEY (shipment_id)
      SOURCE KEY (supplier_code) REFERENCES Supplier (supplier_id)
      DESTINATION KEY (plant_id) REFERENCES Plant (plant_id)
      LABEL SHIPS_TO PROPERTIES ALL COLUMNS,
    `${project}.${dataset}.vehicle_models` AS BUILT_AT
      KEY (model_id)
      SOURCE KEY (model_id) REFERENCES VehicleModel (model_id)
      DESTINATION KEY (plant_id) REFERENCES Plant (plant_id)
      LABEL BUILT_AT PROPERTIES ALL COLUMNS
  )
