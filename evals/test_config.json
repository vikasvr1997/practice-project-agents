        },
        {
          "rubric_id": "concise",
          "rubric_content": {
            "text_property": "The response is 5 sentences or fewer, or a short list, and leads with the answer."
          }
        },
        {
          "rubric_id": "on_topic",
          "rubric_content": {
            "text_property": "The response stays on vehicle crash and safety data."
          }
        }
      ]
    },
    "hallucinations_v1": {
      "threshold": 0.8,
      "judge_model_options": {
        "judge_model": "gemini-3.5-flash"
      }
    },
