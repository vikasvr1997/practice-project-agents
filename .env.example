# Copy to .env for local runs. Never commit .env.
APP_API_KEY=change-me-to-a-long-random-string
SESSION_BACKEND=memory             # "memory" for local/tests; "firestore" persists sessions
# FIRESTORE_DATABASE=(default)     # only read when SESSION_BACKEND=firestore

# Gemini through Vertex AI (uses your gcloud login, no API key needed)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash

# Where the data lives (defaults to NHTSA public crash data)
BQ_DATA_PROJECT=bigquery-public-data
BQ_DATASET=nhtsa_traffic_fatalities
