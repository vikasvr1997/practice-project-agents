# Copy to .env for local runs. Never commit .env.
APP_API_KEY=change-me-to-a-long-random-string
SESSION_BACKEND=memory             # "memory" for local/tests; "firestore" persists sessions
# FIRESTORE_DATABASE=(default)     # only read when SESSION_BACKEND=firestore

# Gemini through Vertex AI (uses your gcloud login, no API key needed)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash

# Where the data lives (defaults to NHTSA public crash data)
BQ_DATA_PROJECT=bigquery-public-data
BQ_DATASET=nhtsa_traffic_fatalities

# Optional: the supply-chain graph (see "Supply-chain graph agent" in GUIDE.md).
# Empty = the supply_chain_analyst agent is left out.
SUPPLY_CHAIN_GRAPH=

# Optional: Model Armor guardrails, the full template name from
# `terraform output model_armor_template`. Empty = guardrails off.
MODEL_ARMOR_TEMPLATE=

# Logs: "json" for Cloud Logging (default), "text" for readable local lines.
LOG_FORMAT=text
LOG_LEVEL=INFO
# true = also log prompts and answers. Local debugging only: users may type personal data.
LOG_PROMPTS=false
